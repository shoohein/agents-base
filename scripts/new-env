#!/bin/sh -e
# new-env - template から <forge>/<org>/<repo> 環境を生成する
# usage: new-env [options] <forge>/<org>/<repo> [host-repo-path]
# see also: scripts/agent (forge/org/repo パース), template/env/compose.yaml (volumes 定義)

usage() {
  cat << 'USAGE' >&2
usage: new-env [options] <forge>/<org>/<repo> [host-repo-path]
       new-env [options] <org>/<repo> [host-repo-path]  # forge 省略時は gh
       new-env --help | -h

options:
  --help, -h    このヘルプを表示

arguments:
  <forge>/<org>/<repo>   環境の配置先 (例: gh/me/myrepo, gl/mygroup/myproject)
                         forge: Gitホスティング識別子 [a-z0-9_-]+ (例: gh, gl, gb)
  <org>/<repo>           forge省略時は gh として扱う (後方互換)
  [host-repo-path]       ホストの作業リポジトリ絶対パス (省略時は ${REPOS_ROOT:-$HOME}/<forge>/<org>/<repo>)

examples:
  new-env gh/me/myrepo
  new-env gh/me/myrepo ~/src/myrepo
  new-env me/myrepo                    # gh/me/myrepo と同等
  new-env gl/mygroup/myproject

environment:
  REPOS_ROOT            クローン集約ルート

see also:
  scripts/agent <env>    生成した環境を起動する
USAGE
}

# --- parse wrapper options (strictly before <repo>) ---
while [ $# -gt 0 ]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    --*)
      echo "error: unknown option '$1'" >&2
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -eq 0 ]; then
  echo "error: <forge>/<org>/<repo> is required" >&2
  usage
  exit 1
fi

REPO_SLUG="$1"
HOST_REPO_ARG="${2:-}"
if [ $# -gt 2 ]; then
  echo "error: too many arguments (expected 1-2, got $#)" >&2
  usage
  exit 1
fi

# forge 判定: スラッシュ数で分岐
#   2スラッシュ以上 (forge/org/repo) → forge を抽出
#   1スラッシュ (org/repo)           → forge=gh として後方互換
case "$REPO_SLUG" in
  */*/*)
    FORGE="$(echo "$REPO_SLUG" | cut -d/ -f1)"
    REST="$(echo "$REPO_SLUG" | cut -d/ -f2-)"
    # forge バリデーション: 英小文字・数字・ハイフン・アンダースコアのみ
    if ! echo "$FORGE" | grep -Eq '^[a-z0-9_-]+$'; then
      echo "error: invalid forge '$FORGE' (allowed: [a-z0-9_-]+)" >&2
      exit 1
    fi
    DEST="$REPO_SLUG"
    if [ -z "$HOST_REPO_ARG" ]; then
      HOST_REPO="${REPOS_ROOT:-$HOME}/$REPO_SLUG"
    else
      HOST_REPO="$HOST_REPO_ARG"
    fi
    ;;
  */*)
    # 後方互換: forge 省略 → gh
    FORGE="gh"
    DEST="gh/$REPO_SLUG"
    if [ -z "$HOST_REPO_ARG" ]; then
      HOST_REPO="${REPOS_ROOT:-$HOME}/gh/$REPO_SLUG"
    else
      HOST_REPO="$HOST_REPO_ARG"
    fi
    ;;
  *)
    echo "error: <forge>/<org>/<repo> or <org>/<repo> expected (got '$REPO_SLUG')" >&2
    usage
    exit 1
    ;;
esac

if [ -e "$DEST" ]; then
  echo "error: $DEST already exists" >&2
  exit 1
fi

if [ ! -d template ]; then
  echo "error: template/ not found" >&2
  exit 1
fi

# template をコピー
mkdir -p "$(dirname "$DEST")"
cp -a template "$DEST"

# compose.yaml のプレースホルダを置換
_ESCAPED_HOST_REPO="$(printf '%s' "$HOST_REPO" | sed 's/[&|\\]/\\&/g')"
_ESCAPED_DEST="$(printf '%s' "$DEST" | sed 's/[&|\\]/\\&/g')"
sed -i "s|\${REPOS_ROOT:-\${HOME}}/<forge>/<org>/<repo>|$_ESCAPED_HOST_REPO|g" "$DEST/env/compose.yaml"
sed -i "s|agents/<forge>/<org>/<repo>|agents/$_ESCAPED_DEST|g" "$DEST/env/compose.yaml"

mkdir -p "$DEST/worklogs"

echo "created $DEST"
echo "  host repo : $HOST_REPO -> /workspaces/main"
echo "  next: scripts/agent $REPO_SLUG"
